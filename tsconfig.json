{
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node"],
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["nodes/**/*.ts"]
}
